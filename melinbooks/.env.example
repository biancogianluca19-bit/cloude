# Dirección pública del sitio (sin barra final). Se usa en el sitemap,
# en las URLs canónicas y en las imágenes para compartir.
# Ejemplo: https://www.melinbooks.com.ar. En Vercel, si no la definís, se usa el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=

# Analítica opcional (dejá vacío lo que no uses).
# Vercel Web Analytics: activala en el panel de Vercel (pestaña Analytics) y poné "true".
NEXT_PUBLIC_VERCEL_ANALYTICS=
# Plausible: el dominio tal como lo cargaste en plausible.io
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4: el ID de medición (G-XXXXXXX)
NEXT_PUBLIC_GA_ID=
