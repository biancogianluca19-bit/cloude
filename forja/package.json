{
  "name": "forja",
  "private": true,
  "version": "1.0.0",
  "description": "FORJA: entrenador personal para preparar parciales universitarios a partir del material de cada materia.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:files": "tsx scripts/make-demo-files.ts",
    "e2e": "tsx scripts/e2e-browser.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "jszip": "^3.10.2",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "docx": "^9.7.2",
    "lucide-react": "^1.47.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
