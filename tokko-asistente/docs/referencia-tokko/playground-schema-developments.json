  "apis": [
    {
      "operations": [
        {
          "httpMethod": "GET",
          "nickname": "development-list",
          "responseClass": "List",
          "summary": "List of available developments.",
          "notes": "\nReturn all of the available developments.\nThis developments must've been marked as \"show on web\" on their details.\nRequires Api Key.\n",
          "parameters": [
            {
              "dataType": "String",
              "paramType": "query",
              "required": false,
              "name": "lang",
              "description": "Language of the results, defaults to 'en'",
              "allowableValues": {
                "values": [
                  "es_ar",
                  "en"
                ],
                "valueType": "list"
              }
            },
            {
              "dataType": "String",
              "paramType": "query",
              "required": false,
              "name": "format",
              "description": "Format of the results, defaults to 'json'",
              "allowableValues": {
                "values": [
                  "json",
                  "xml"
                ],
                "valueType": "list"
              }
            },
            {
              "dataType": "int",
              "paramType": "query",
              "required": false,
              "name": "limit",
              "description": "Number of results to show. Default: 20"
            },
            {
              "dataType": "int",
              "paramType": "query",
              "required": false,
              "name": "offset",
              "description": "Number of result item to start showing. Useful for pagination purposes {Combined with 'limit' parameter}. Default: 0"
            }
          ]
        }
      ],
      "path": "/api/v1/development/"
    },
