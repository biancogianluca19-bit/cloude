# Copiá este archivo como .env y completá los valores.
# .env no se sube a git (está en .gitignore).

# API key de Tokko. La ve un usuario administrador en Mi empresa > Permisos.
# Si queda vacía, la app corre en modo mock con propiedades de ejemplo.
TOKKO_API_KEY=

# mock: usa fixtures/propiedades-ejemplo.json (no llama a Tokko)
# live: lee las propiedades desde la API de Tokko (solo GET)
# Si no hay key, el modo es siempre mock.
TOKKO_MODE=mock

# Cada cuántos minutos se sincroniza el caché de propiedades en modo live (entre 15 y 30).
TOKKO_SYNC_MINUTOS=20

# Ponelo en true recién cuando hayas corrido "npm run descubrir" y revisado el normalizador
# contra una propiedad real. Mientras sea false, la pantalla muestra "SIN VALIDAR".
TOKKO_CAMPOS_VALIDADOS=false

# Servidor local. 127.0.0.1 = solo esta PC.
# Para abrirlo desde el celular en la misma red WiFi usá HOST=0.0.0.0 (ver README).
HOST=127.0.0.1
PORT=3000
